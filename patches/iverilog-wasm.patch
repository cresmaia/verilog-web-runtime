+    'io-range-error': 'io_range_error', 'strict-ca-eval': 'strict_ca_eval',
+    'strict-expr-width': 'strict_expr_width', 'shared-loop-index': 'shared_loop_index',
+    'allow-real-arg-to-bits': 'allow_real_arg_to_bits', 'verilog-ams': 'verilog_ams',
