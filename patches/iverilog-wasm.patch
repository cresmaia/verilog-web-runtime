+<main>
+  <div class="col">
+    <section class="pane"><h2><span>design.v</span></h2><textarea id="design" spellcheck="false"></textarea></section>
+    <section class="pane"><h2><span>tb.v</span></h2><textarea id="tb" spellcheck="false"></textarea></section>
+  </div>
+  <div class="col">
+    <section class="pane"><h2><span>Console</span><span id="status">Loading…</span></h2><pre id="console"></pre></section>
+    <section class="pane"><h2><span>Waveform</span><a id="dl" href="#" download="dump.vcd" hidden>Download VCD</a></h2>
+      <div class="wavebox" id="wavebox"><div class="empty">Run a testbench with $dumpfile/$dumpvars to see waveforms.</div></div>
+    </section>
+  </div>
+</main>
+<footer>Icarus Verilog © Stephen Williams and contributors, licensed under the GNU GPL version 2 or later.
+  This page runs a WebAssembly build of it. Source: the upstream repository plus
+  <a href="SOURCE.patch">SOURCE.patch</a> (the changes and build script used for this build).</footer>
+
+<script>
+const EXAMPLES = {
+  counter: {
+    design: `module counter #(parameter W = 4) (
+  input  wire         clk,
+  input  wire         rst,
+  output reg  [W-1:0] q
+);
+  always @(posedge clk or posedge rst)
+    if (rst) q <= 0;
+    else     q <= q + 1'b1;
+endmodule
+`,
+    tb: `\`timescale 1ns/1ps
+module tb;
+  reg clk = 0, rst = 1;
+  wire [3:0] q;
+  counter dut(.clk(clk), .rst(rst), .q(q));
+
+  always #5 clk = ~clk;
+
+  initial begin
+    $dumpfile("dump.vcd");
+    $dumpvars(0, tb);
+    #12 rst = 0;
+    repeat (20) @(posedge clk);
+    $display("q = %0d at %0t", q, $time);
+    $finish;
+  end
+endmodule
+`},
+  real: {
+    design: `module scale(input real x, output real y);
+  assign y = $sqrt(x) * 2.0;
+endmodule
+`,
+    tb: `module tb;
+  real x, y;
+  integer seed = 7, r, i;
+  scale dut(.x(x), .y(y));
+  initial begin
+    $dumpfile("dump.vcd");
+    $dumpvars(0, tb);
+    for (i = 0; i < 6; i = i + 1) begin
+      x = i * 1.5;
+      r = $random(seed) % 10;     // signed: can be negative
+      #1 $display("x=%4.1f  y=%8.5f  r=%0d", x, y, r);
+    end
+  end
+endmodule
+`},
+  forever: {
+    design: `module blink(input clk, output reg led = 0);
+  always @(posedge clk) led <= ~led;
+endmodule
+`,
+    tb: `module tb;
+  reg clk = 0;
+  wire led;
+  blink dut(.clk(clk), .led(led));
+  always #1 clk = ~clk;          // no $finish: runs until you press Stop
+  initial begin
+    $display("running forever...");
+    forever #1000000 $display("t = %0t", $time);
+  end
+endmodule
+`}
+};
+
+const $ = (s) => document.querySelector(s);
+const con = $('#console'), status = $('#status');
+let worker = null, runId = 0, lastVcdUrl = null, waveObserver = null;
+
+function log(text, cls) {
+  const span = document.createElement('span');
+  if (cls) span.className = cls;
+  span.textContent = text + '\n';
+  con.appendChild(span);
+  if (con.childNodes.length > 2000) con.removeChild(con.firstChild);
+  con.scrollTop = con.scrollHeight;
+}
+function setStatus(text, cls) { status.textContent = text; status.className = cls || ''; }
+
+function startWorker() {
+  worker = new Worker('worker.js');
+  worker.onmessage = (e) => {
+    const m = e.data;
+    if (m.id !== runId) return;
+    if (m.type === 'line') log(m.text, m.stream === 'stderr' ? 'stderr' : '');
+    else if (m.type === 'error') { log(m.message, 'stderr'); finish(false, 'Error'); }
+    else if (m.type === 'done') {
+      const t = m.compileMs != null ? `compile ${m.compileMs.toFixed(0)} ms, total ${m.ms.toFixed(0)} ms`
+                                    : `${m.ms.toFixed(0)} ms`;
+      if (!m.ok) log(`${m.stage} exited with status ${m.rc}`, 'info');
+      else log(`finished (${t})`, 'info');
+      if (m.vcd) showVcd(m.vcd, m.vcdName);
+      finish(m.ok, m.ok ? 'Done' : (m.stage === 'vvp' ? 'Simulation error' : 'Compile error'));
+    }
+  };
+  worker.onerror = (e) => { log(String(e.message || e), 'stderr'); finish(false, 'Worker error'); };
+}
+
+function finish(ok, text) {
+  $('#run').disabled = false; $('#stop').disabled = true;
+  setStatus(text, ok ? 'ok' : 'err');
+}
+
+function run() {
+  con.textContent = '';
+  runId += 1;
+  $('#run').disabled = true; $('#stop').disabled = false;
+  setStatus('Running…');
+  worker.postMessage({ id: runId, generation: $('#gen').value,
+    files: { 'design.v': $('#design').value, 'tb.v': $('#tb').value } });
+}
+
+function stop() {
+  worker.terminate();            // the only way to interrupt a running wasm call
+  startWorker();
+  log('stopped', 'info');
+  finish(false, 'Stopped');
+}
+
+function loadExample(name) {
+  $('#design').value = EXAMPLES[name].design;
+  $('#tb').value = EXAMPLES[name].tb;
+}
+
+/* ---------- minimal VCD parser and waveform drawing ---------- */
+function parseVcd(text) {
+  const tok = text.split(/\s+/);
+  const vars = [], byId = new Map(), scope = [];
+  let i = 0, t = 0, tmax = 0, timescale = '';
+  const skipToEnd = () => { const out = []; while (i < tok.length && tok[i] !== '$end') out.push(tok[i++]); i++; return out; };
+  const change = (id, v) => { const list = byId.get(id); if (list) for (const vr of list) vr.ch.push([t, v]); };
+  while (i < tok.length) {
+    const w = tok[i++];
+    if (!w) continue;
+    if (w === '$scope') { const a = skipToEnd(); scope.push(a[1]); }
+    else if (w === '$upscope') { skipToEnd(); scope.pop(); }
+    else if (w === '$var') {
+      const a = skipToEnd();
+      const vr = { type: a[0], width: +a[1], id: a[2], name: scope.concat(a[3]).join('.'), ch: [] };
+      vars.push(vr);
+      if (!byId.has(vr.id)) byId.set(vr.id, []);
+      byId.get(vr.id).push(vr);
+    }
+    else if (w === '$timescale') timescale = skipToEnd().join('');
+    else if (w === '$dumpvars' || w === '$dumpall' || w === '$dumpon' || w === '$dumpoff' || w === '$end') { /* changes follow */ }
+    else if (w[0] === '$') skipToEnd();
+    else if (w[0] === '#') { t = parseInt(w.slice(1), 10); if (t > tmax) tmax = t; }
+    else if (/^[bBrR]/.test(w)) change(tok[i++], w.slice(1));
+    else change(w.slice(1), w[0]);
+  }
+  return { vars, tmax, timescale };
+}
+
+function fmtBus(v, vr) {
+  if (vr.type === 'real') { const n = parseFloat(v); return Number.isFinite(n) ? String(+n.toPrecision(6)) : v; }
+  if (/^[01]+$/.test(v)) {
+    if (vr.type === 'integer')                       // integers as signed decimal
+      return String(v.length === 32 && v[0] === '1' ? parseInt(v, 2) - 2 ** 32 : parseInt(v, 2));
+    return BigInt('0b' + v).toString(16);          // other vectors in hex
+  }
+  return v.length > 12 ? v.slice(0, 11) + '…' : v;
+}
+
+// Tick step of 1, 2 or 5 times a power of ten, and a label in a readable unit.
+function niceStep(span, n) {
+  const raw = span / n, p = 10 ** Math.floor(Math.log10(raw)), f = raw / p;
+  return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10) * p;
+}
+function timeLabel(t, timescale) {
+  const m = /^(\d+)(s|ms|us|ns|ps|fs)$/.exec(timescale || '1s') || [0, '1', 's'];
+  const exp = { s: 0, ms: -3, us: -6, ns: -9, ps: -12, fs: -15 };
+  const units = ['s', 'ms', 'us', 'ns', 'ps', 'fs'];
+  const sec = t * (+m[1]) * 10 ** exp[m[2]];
+  if (sec === 0) return '0';
+  for (const u of units) {
+    const v = sec / 10 ** exp[u];
+    if (Math.abs(v) >= 1) return +v.toPrecision(4) + ' ' + u;
+  }
+  return +(sec / 1e-15).toPrecision(4) + ' fs';
+}
+
+function showVcd(text, name) {
+  if (lastVcdUrl) URL.revokeObjectURL(lastVcdUrl);
+  lastVcdUrl = URL.createObjectURL(new Blob([text], { type: 'text/plain' }));
+  const dl = $('#dl'); dl.href = lastVcdUrl; dl.download = name || 'dump.vcd'; dl.hidden = false;
+  const vcd = parseVcd(text);
+  // one row per distinct signal (a port and the net it is connected to share an id)
+  const seen = new Set(), rows = [];
+  for (const vr of vcd.vars) { if (!seen.has(vr.id)) { seen.add(vr.id); rows.push(vr); } }
+  const box = $('#wavebox');
+  box.innerHTML = '';
+  if (!rows.length) { box.innerHTML = '<div class="empty">The VCD file has no signals.</div>'; return; }
+  const canvas = document.createElement('canvas');
+  canvas.id = 'waves';
+  box.appendChild(canvas);
+  const draw = () => { if (canvas.isConnected) drawWaves(canvas, rows, vcd); };
+  draw();
+  if (waveObserver) waveObserver.disconnect();
+  waveObserver = new ResizeObserver(draw);
+  waveObserver.observe(box);
+}
+
+function drawWaves(canvas, rows, vcd) {
+  const css = getComputedStyle(document.documentElement);
+  const col = (n) => css.getPropertyValue(n).trim();
+  const W = canvas.parentElement.clientWidth, rowH = 24, top = 22;
+  const H = top + rows.length * rowH + 4, dpr = window.devicePixelRatio || 1;
+  canvas.width = W * dpr; canvas.height = H * dpr; canvas.style.height = H + 'px';
+  const g = canvas.getContext('2d');
+  g.scale(dpr, dpr);
+  g.font = '11.5px ui-monospace, Menlo, Consolas, monospace';
+  const nameW = Math.min(170, Math.max(90, W * 0.28)), x0 = nameW + 6, x1 = W - 8;
+  const tmax = Math.max(1, vcd.tmax), X = (t) => x0 + (x1 - x0) * t / tmax;
+  // time axis with round tick values
+  g.fillStyle = col('--muted'); g.strokeStyle = col('--grid'); g.lineWidth = 1;
+  const step = niceStep(tmax, Math.max(2, Math.floor((x1 - x0) / 90)));
+  g.textAlign = 'center';
+  for (let t = 0; t <= tmax + 1e-9; t += step) {
+    const x = X(t);
+    g.beginPath(); g.moveTo(Math.round(x) + .5, top - 4); g.lineTo(Math.round(x) + .5, H); g.stroke();
+    g.fillText(timeLabel(t, vcd.timescale), Math.min(Math.max(x, x0 + 12), x1 - 16), 12);
+  }
+  g.textAlign = 'left';
+  rows.forEach((vr, r) => {
+    const yT = top + r * rowH + 4, yB = yT + rowH - 8, yM = (yT + yB) / 2;
+    g.fillStyle = col('--ink');
+    let label = vr.name;
+    while (g.measureText(label).width > nameW - 8 && label.length > 4) label = '…' + label.slice(2);
+    g.fillText(label, 4, yM + 4);
+    const ch = vr.ch;
+    for (let k = 0; k < ch.length; k++) {
+      const [t, v] = ch[k], tn = k + 1 < ch.length ? ch[k + 1][0] : tmax;
+      const xa = X(t), xb = X(tn);
+      if (xb < xa) continue;
+      if (vr.width === 1 && vr.type !== 'real' && v.length === 1) {
+        const c = v === '1' ? yT : v === '0' ? yB : yM;
+        g.strokeStyle = v === 'x' || v === 'X' ? col('--wave-x') : v === 'z' || v === 'Z' ? col('--wave-z') : col('--wave');
+        g.lineWidth = 1.5;
+        g.beginPath();
+        if (k > 0) { const pv = ch[k - 1][1]; const pc = pv === '1' ? yT : pv === '0' ? yB : yM; g.moveTo(xa, pc); g.lineTo(xa, c); }
+        else g.moveTo(xa, c);
+        g.lineTo(xb, c); g.stroke();
+        if (v === 'x' || v === 'X') { g.fillStyle = col('--wave-x'); g.globalAlpha = .18; g.fillRect(xa, yT, xb - xa, yB - yT); g.globalAlpha = 1; }
+      } else {
+        const bad = /[xXzZ]/.test(v);
+        g.strokeStyle = bad ? col('--wave-x') : col('--bus'); g.lineWidth = 1.2;
+        const d = Math.min(3, (xb - xa) / 2);
+        g.beginPath();
+        g.moveTo(xa, yM); g.lineTo(xa + d, yT); g.lineTo(xb - d, yT); g.lineTo(xb, yM);
+        g.lineTo(xb - d, yB); g.lineTo(xa + d, yB); g.closePath(); g.stroke();
+        const s = fmtBus(v, vr);
+        if (g.measureText(s).width < xb - xa - 8) { g.fillStyle = col('--ink'); g.fillText(s, xa + 5, yM + 4); }
+      }
+    }
+  });
+}
+
+$('#run').onclick = run;
+$('#stop').onclick = stop;
+$('#example').onchange = (e) => loadExample(e.target.value);
+document.addEventListener('keydown', (e) => { if ((e.ctrlKey || e.metaKey) && e.key === 'Enter' && !$('#run').disabled) run(); });
+loadExample('counter');
+startWorker();
+setStatus('Ready');
+</script>
+</body>
+</html>
diff --git a/wasm/demo/worker.js b/wasm/demo/worker.js
new file mode 100644
index 000000000..14632ed24
--- /dev/null
+++ b/wasm/demo/worker.js
@@ -0,0 +1,32 @@
+/*
+ * Web Worker that runs Icarus Verilog (ivlpp -> ivl -> vvp) in WebAssembly.
+ * Running in a worker keeps the page responsive, and an endless simulation
+ * can be stopped with worker.terminate().
+ *
+ * message in:  { id, files: {name: text}, generation, top, args }
+ * messages out: { id, type: 'line', stream, text }
+ *               { id, type: 'done', ok, stage, rc, vcd, vcdName, ms }
+ *               { id, type: 'error', message }
+ */
+importScripts('ivlpp.js', 'ivl.js', 'vvp.js', 'iverilog-wasm.js');
+
+const iv = IverilogWasm.create({ createIvlpp, createIvl, createVvp });
+
+onmessage = async (e) => {
+  const { id, files, generation, top, args } = e.data;
+  const post = (type, data) => postMessage(Object.assign({ id, type }, data));
+  const onLine = (stream, text) => post('line', { stream, text });
+  const t0 = performance.now();
+  try {
+    const c = await iv.compile({ files, generation, top, onLine });
+    if (!c.ok) return post('done', { ok: false, stage: c.stage, rc: c.rc, ms: performance.now() - t0 });
+    const t1 = performance.now();
+    const s = await iv.simulate({ vvp: c.vvp, args, onLine });
+    const vcdName = Object.keys(s.files).find((n) => /\.vcd$/i.test(n));
+    const vcd = vcdName ? new TextDecoder().decode(s.files[vcdName]) : null;
+    post('done', { ok: s.rc === 0, stage: 'vvp', rc: s.rc, vcd, vcdName,
+                   ms: performance.now() - t0, compileMs: t1 - t0 });
+  } catch (err) {
+    post('error', { message: String((err && err.stack) || err) });
+  }
+};
diff --git a/wasm/dup_offset.c b/wasm/dup_offset.c
new file mode 100644
index 000000000..f1d8911a6
--- /dev/null
+++ b/wasm/dup_offset.c
@@ -0,0 +1,30 @@
+/*
+ * dup() for Emscripten builds of vvp.
+ *
+ * The LXT, LXT2 and FST writers (vpi/lxt_write.c, vpi/lxt2_write.c,
+ * vpi/fstapi.c) write compressed sections through gzdopen(dup(fd)) and
+ * expect the new descriptor to start at the current file offset, as the
+ * POSIX dup() does. Emscripten's dup() reopens the file instead, and in
+ * some versions the new descriptor starts at offset 0, which overwrites
+ * the start of the file. Linking this file makes dup() carry the offset
+ * over. (The writers seek to the end again after gzclose(), so a copied
+ * rather than shared offset is enough.)
+ *
+ * This file is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.
+ */
+#include <fcntl.h>
+#include <unistd.h>
+
+int dup(int fd)
+{
+      int nfd = fcntl(fd, F_DUPFD, 0);
+      if (nfd >= 0) {
+	    off_t pos = lseek(fd, 0, SEEK_CUR);
+	    if (pos >= 0)
+		  lseek(nfd, pos, SEEK_SET);
+      }
+      return nfd;
+}
diff --git a/wasm/iverilog-node.js b/wasm/iverilog-node.js
new file mode 100644
index 000000000..b823e7ef0
--- /dev/null
+++ b/wasm/iverilog-node.js
@@ -0,0 +1,106 @@
+#!/usr/bin/env node
+/*
+ * Command line front end for the WebAssembly build, for testing in Node:
+ *
+ *   node iverilog-node.js [-g2012] [-DNAME[=V]] [-Idir] [-s top] [-y libdir] [-v lib.v]
+ *                         [-u] [-Wall] [-o a.vvp] file.v ...
+ *   node iverilog-node.js --run [same options] [+plusarg ...] [-fst|-lxt2|-none] file.v ...
+ *
+ * Without --run it only compiles (like iverilog). With --run it also
+ * simulates (like vvp) and writes the files the simulation created
+ * (dump.vcd, ...) to the current directory.
+ *
+ * Needs ivlpp.js/.wasm, ivl.js/.wasm, vvp.js/.wasm next to this file (or
+ * in the directory given by IVERILOG_WASM_DIR).
+ */
+'use strict';
+const fs = require('fs');
+const path = require('path');
+
+const dir = path.resolve(process.env.IVERILOG_WASM_DIR || __dirname);
+const IverilogWasm = require('./iverilog-wasm.js');
+const iv = IverilogWasm.create({
+  createIvlpp: require(path.join(dir, 'ivlpp.js')),
+  createIvl: require(path.join(dir, 'ivl.js')),
+  createVvp: require(path.join(dir, 'vvp.js')),
+  locateFile: (f) => path.join(dir, f),
+});
+
+async function main(argv) {
+  const opt = { files: {}, sourceOrder: [], defines: {}, includeDirs: [], top: [] };
+  let out = 'a.out', run = false;
+  const plusargs = [];
+  for (let i = 0; i < argv.length; i++) {
+    const a = argv[i];
+    const val = () => (a.length > 2 ? a.slice(2) : argv[++i]);
+    if (a === '--run') run = true;
+    else if (a.startsWith('-g')) (opt.generation = [].concat(opt.generation || [])).push(a.slice(2));
+    else if (a.startsWith('-D')) { const [k, v] = val().split('='); opt.defines[k] = v === undefined ? true : v; }
+    else if (a.startsWith('-I')) opt.includeDirs.push(val());
+    else if (a.startsWith('-s')) opt.top.push(val());
+    else if (a.startsWith('-o')) out = val();
+    else if (a.startsWith('-v') && a.length > 2 || a === '-v' && argv[i + 1] && !argv[i + 1].startsWith('-')) {
+      const f = val(); opt.files[f] = fs.readFileSync(f); (opt.libraryFiles = opt.libraryFiles || []).push(f);
+    }
+    else if (a.startsWith('-y')) (opt.libraryDirs = opt.libraryDirs || []).push(val());
+    else if (a.startsWith('-Y')) (opt.libraryExts = opt.libraryExts || []).push(val());
+    else if (a === '-Wall') opt.warnings = 'nuidRpsta';   // same letters as the iverilog driver
+    else if (a === '-u') opt.separateUnits = true;
+    else if (a.startsWith('+')) plusargs.push(a);
+    // vvp "extended" arguments go after the .vvp file: -fst, -lxt2, -none, ...
+    else if (/^-(vcd|fst|lxt|lxt2)(-.*)?$|^-none$|^-sdf-/.test(a) || a.startsWith('--vvp-arg='))
+      plusargs.push(a.replace(/^--vvp-arg=/, ''));
+    else { opt.files[a] = fs.readFileSync(a); opt.sourceOrder.push(a); }
+  }
+  // The wasm modules only see the files handed to them, so find the
+  // `include files the sources need (relative to the current directory, the
+  // including file's directory, or a -I directory) and pass those along too.
+  const isFile = (p) => { try { return fs.statSync(p).isFile(); } catch (e) { return false; } };
+  const queue = Object.keys(opt.files);
+  while (queue.length) {
+    const f = queue.shift();
+    const text = String(opt.files[f]);
+    for (const m of text.matchAll(/`include\s+"([^"]+)"/g)) {
+      for (const cand of [m[1], path.join(path.dirname(f), m[1])].concat(opt.includeDirs.map((d) => path.join(d, m[1])))) {
+        const key = path.normalize(cand);
+        if (!opt.files[key] && isFile(key)) { opt.files[key] = fs.readFileSync(key); queue.push(key); }
+      }
+    }
+  }
+  // Write the bytes exactly as the program wrote them (not re-encoded text).
+  const echo = (stream, s, bytes) => {
+    const to = stream === 'stderr' ? process.stderr : process.stdout;
+    to.write(bytes ? Buffer.concat([Buffer.from(bytes), Buffer.from('\n')]) : s + '\n');
+  };
+  opt.onLine = echo;
+  opt.findFile = (f) => (isFile(f) ? fs.readFileSync(f) : null);
+
+  const c = await iv.compile(opt);
+  if (!c.ok) return c.rc || 1;
+  if (!run) { fs.writeFileSync(out, c.vvp); return 0; }
+
+  // Data files for $readmemh, $fopen("r"), $sdf_annotate, ...: every
+  // non-Verilog file (< 4 MB) in the current directory and in the
+  // directories of the source files.
+  const data = {};
+  const dirs = new Set(['.'].concat(opt.sourceOrder.map((f) => path.dirname(f))));
+  for (const d of dirs)
+    for (const n of fs.readdirSync(d)) {
+      const p = d === '.' ? n : path.join(d, n);
+      if (/\.(v|sv|vh|svh|vhd|vhdl|vvp)$/i.test(n) || data[p]) continue;
+      const st = fs.statSync(p);
+      if (st.isFile() && st.size < 4 << 20) data[p] = fs.readFileSync(p);
+    }
+
+  const subdirs = fs.readdirSync('.').filter((n) => { try { return fs.statSync(n).isDirectory(); } catch (e) { return false; } });
+  const s = await iv.simulate({ vvp: c.vvp, files: data, dirs: subdirs, args: plusargs,
+    onLine: echo });
+  for (const [name, bytes] of Object.entries(s.files)) {
+    fs.mkdirSync(path.dirname(name), { recursive: true });
+    fs.writeFileSync(name, bytes);
+  }
+  return s.rc;
+}
+
+main(process.argv.slice(2)).then((rc) => { process.exitCode = rc; },
+  (e) => { console.error(e); process.exitCode = 99; });
