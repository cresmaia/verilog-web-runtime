+/*
+ * Without threads (e.g. WebAssembly built without pthreads) there is no
+ * separate work thread. Instead, each time a batch is released the
+ * consumer function runs right away on everything that is queued, with an
+ * extra WT_TERMINATE item after it so that its loop returns when the queue
+ * is empty.
+ */
+#if !defined(VCD_WORK_INLINE) && defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
+# define VCD_WORK_INLINE 1
+#endif
+#ifdef VCD_WORK_INLINE
+static void* (*work_fun)(void*) = 0;
+static void* work_arg = 0;
+static void drain_work_queue(void);
+#endif
+
 static const unsigned WORK_QUEUE_SIZE = 128*1024;
 static const unsigned WORK_QUEUE_BATCH_MIN = 4*1024;
 static const unsigned WORK_QUEUE_BATCH_MAX = 32*1024;
@@ -157,7 +173,12 @@ static unsigned current_batch_base = 0;
 
 extern "C" void vcd_work_start( void* (*fun) (void*), void*arg )
 {
+#ifdef VCD_WORK_INLINE
+      work_fun = fun;
+      work_arg = arg;
+#else
