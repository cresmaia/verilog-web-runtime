+          FS.writeFile(BASE + '/vvp.conf', VVP_CONF);
+          FS.writeFile(WORK + '/.ivl_iconfig', iconfigText(opt, WORK + '/a.vvp'));
+          writeFiles(FS, Object.fromEntries(pre));
+        }, onLine);
