             work_queue_notempty_sig.notify_one();
 
+#ifdef VCD_WORK_INLINE
+      drain_work_queue();
+#endif
+}
+
+#ifdef VCD_WORK_INLINE
+static void drain_work_queue(void)
+{
+      if (work_fun == 0 || work_queue_fill == 0)
+	    return;
+
+      unsigned last = work_queue_next + work_queue_fill - 1;
+      if (last >= WORK_QUEUE_SIZE)
+	    last -= WORK_QUEUE_SIZE;
+      unsigned stop = last + 1;
+      if (stop >= WORK_QUEUE_SIZE)
+	    stop -= WORK_QUEUE_SIZE;
+      work_queue[stop].type = WT_TERMINATE;
+      work_queue[stop].time = work_queue[last].time;
+      work_queue_fill += 1;
+
+      work_fun(work_arg);
+
+	// If the queue held a real WT_TERMINATE the consumer stopped there,
+	// and only the extra item is left. Drop it.
+      if (work_queue_fill > 0) {
+	    work_queue_next = stop + 1 < WORK_QUEUE_SIZE ? stop + 1 : 0;
+	    work_queue_fill = 0;
+      }
 }
+#endif
 
 static inline void unlock_item(bool flush_batch =false)
 {
@@ -279,5 +330,7 @@ extern "C" void vcd_work_terminate(void)
       struct vcd_work_item_s*cell = grab_item();
       cell->type = WT_TERMINATE;
       unlock_item(true);
+#ifndef VCD_WORK_INLINE
       work_thread.join();
+#endif
 }
